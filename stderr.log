   713	let agent_context_snapshot ?stage config issue attempt ~workspace ~loop_start_branch =
   714	  match match stage with Some _ -> stage | None -> stage_for_issue config issue with
   715	  | Some stage when Config.stage_context_snapshot_enabled stage -> (
   716	      match stage.Config.context_snapshot with
   717	      | Some snapshot ->
   718	          let lines =
   719	            [
   720	              "## Agent Context Snapshot";
   721	              "";
   722	              Printf.sprintf "- Issue: %s %s" issue.Issue.identifier (compact_markdown_value issue.title);
   723	              Printf.sprintf "- Project status: %s" issue.state;
   724	              Printf.sprintf "- Labels: %s" (if issue.labels = [] then "(none)" else String.concat ", " issue.labels);
   725	              Printf.sprintf "- Blockers: %s" (blockers_line issue.blocked_by);
   726	              Printf.sprintf "- Attempt: %d" (Option.value attempt ~default:0);
   727	              Printf.sprintf "- Stage Agent: %s" stage.agent;
   728	              Printf.sprintf "- Task Branch: %s" (task_branch config issue);
   729	              Printf.sprintf "- Agent Worktree: %s" workspace.Workspace.path;
   730	            ]
   731	            @ optional_line "Loop-Start Branch" loop_start_branch
   732	          in
   733	          Some (String.concat "\n" lines |> truncate_snapshot snapshot.max_output_bytes)
   734	      | None -> None)
   735	  | _ -> None
