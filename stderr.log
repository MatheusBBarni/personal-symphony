  2065	        let available = orchestrator.config.agent.max_concurrent_agents - List.length orchestrator.state.running in
  2066	        let dispatchable =
  2067	          candidates
  2068	          |> List.filter (fun issue ->
  2069	                 issue_is_active orchestrator issue
  2070	                 && (not (is_running orchestrator.state issue))
  2071	                 && (not (is_blocked orchestrator issue))
  2072	                 && retrying_due orchestrator issue)
