+      let pi_harness =
+        {
+          Config.name = "pi";
+          kind = "pi";
+          command = "sh -c 'pwd > pi.cwd; cat > pi.prompt'";
+          model = Config.default_pi_model;
+          reasoning_effort = Config.default_reasoning_effort;
+          turn_timeout_ms = 1000;
+          read_timeout_ms = 100;
+          stall_timeout_ms = 1000;
+        }
+      in
+      let config =
+        {
+          Config.workflow_path = "settings.json";
