          last_error = Some error;
        });
      update_ordered_queue_entries orchestrator ~skipped:(row.issue.identifier, error) ~candidates:[ row.issue ] ()

let complete_child ?next_status orchestrator child =
  let issue_id = child.issue_id in
  let next_issue =
