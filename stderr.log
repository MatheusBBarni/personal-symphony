+    match
+      Orchestrator.run_shell_capture ~cwd:config.Config.repository_root
+        (Printf.sprintf "git worktree remove %s" (Util.shell_quote workspace.Workspace.path))
+    with
+    | Ok _ -> ()
+    | Error error -> errors := ("worktree cleanup failed: " ^ error) :: !errors);
