          orchestrator.tracker_retry_due <- Some due;
          let seconds = seconds_until due in
          let pause_msg = tracker_retry_pause_message seconds ^ ": " ^ msg in
          set_error orchestrator pause_msg;
          render_poll_paused seconds msg
