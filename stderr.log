  let git =
    {
      (git_policy ~auto_merge:false ()) with
      cleanup = { Config.remove_worktree_after_merge = true; keep_task_branch };
    }
  in
  {
    (base_orchestrator_config root git) with
    stage_agents =
      {
        enabled = true;
        root = Filename.concat root "agents";

