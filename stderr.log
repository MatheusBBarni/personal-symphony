   704	let truncate_snapshot max_output_bytes snapshot =
   705	  if String.length snapshot <= max_output_bytes then snapshot
   706	  else
   707	    let marker = "\n\n[truncated]" in
   708	    if max_output_bytes <= String.length marker then String.sub snapshot 0 max_output_bytes
   709	    else
   710	      let keep = max_output_bytes - String.length marker in
   711	      String.sub snapshot 0 keep |> Util.trim |> fun text -> text ^ marker
