+let normalize_repo_path path =
+  let path = String.map (function '\\' -> '/' | c -> c) path |> Util.trim in
+  let rec drop_prefixes path =
+    match Util.drop_prefix ~prefix:"./" path with Some path -> drop_prefixes path | None -> path
+  in
+  drop_prefixes path
