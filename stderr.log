+let json_bool_strict path json =
+  match json with
+  | `Bool b -> Ok b
+  | `String "true" -> Ok true
+  | `String "false" -> Ok false
+  | `Null -> Ok false
+  | _ -> Error (path ^ " must be a boolean")
