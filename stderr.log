+         match raw with
+         | `Assoc _ ->
+             let name = json_string "name" raw ~default:"" |> Util.trim in
+             let pattern = json_string "pattern" raw ~default:"" |> Util.trim in
+             if name = "" then
+               raise
+                 (Invalid_config
+                    (Printf.sprintf "paths.protected.patterns[%d].name is required" index));
+             if pattern = "" then
+               raise
+                 (Invalid_config
