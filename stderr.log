  2101	  let finished_reported = ref false in
  2102	  while not !finished_reported do
  2103	    poll_once orchestrator;
  2104	    if ordered_queue_finished orchestrator then (
  2105	      (match orchestrator.state.Runtime_state.ordered_queue with
  2106	      | Some queue -> render_ordered_queue_finished queue
  2107	      | None -> ());
