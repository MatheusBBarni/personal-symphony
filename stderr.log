  2110	      let interval_ms = max 1 orchestrator.config.polling.interval_ms in
  2111	      let read_timeout_ms =
  2112	        orchestrator.children
  2113	        |> List.map (fun child -> child.harness.Config.read_timeout_ms)
  2114	        |> List.fold_left min orchestrator.config.codex.read_timeout_ms
