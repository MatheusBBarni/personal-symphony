    match Simple_yaml.get_string "api_key" tracker_raw |> resolve_secret with
    | Some _ as token -> token
    | None -> (
        match Util.getenv_nonempty "GITHUB_TOKEN" with
        | Some _ as token -> token
        | None -> Util.getenv_nonempty "GH_TOKEN")
  in
