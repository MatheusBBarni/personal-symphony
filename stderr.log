+                    max_concurrent_agents = None;
+                    context_snapshot = None;
+                    skills = [];
+                    start_status = Some "In progress";
+                    success_status = Some "In review";
+                    retry_status = Some "Todo";
+                    goal = None;
+                    commit = None;
+                  };
+                ];
+            };
+        }
+      in
+      let issue = Issue.empty ~id:"I1" ~identifier:"#1" ~title:"One" ~state:"Todo" in
