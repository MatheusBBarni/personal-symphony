let colors_enabled () = Sys.getenv_opt "NO_COLOR" = None
let ansi code = if colors_enabled () then "\027[" ^ code ^ "m" else ""

 succeeded in 0ms:
  let path = Filename.concat workspace.Workspace.path "prompt.md" in
