+              Printf.sprintf "- Blockers: %s" (blockers_line issue.blocked_by);
+              Printf.sprintf "- Attempt: %d" (Option.value attempt ~default:0);
+              Printf.sprintf "- Stage Agent: %s" stage.agent;
