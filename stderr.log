+      only_stars p
+    else if p < pattern_len then
+      match pattern.[p] with
+      | '*' -> loop (p + 1) t (Some p) t
+      | '?' -> loop (p + 1) (t + 1) star next_t
+      | c when c = text.[t] -> loop (p + 1) (t + 1) star next_t
+      | _ -> (
+          match star with
+          | Some star_p when next_t < text_len -> loop (star_p + 1) (next_t + 1) star (next_t + 1)
+          | _ -> false)
+    else
+      match star with
+      | Some star_p when next_t < text_len -> loop (star_p + 1) (next_t + 1) star (next_t + 1)
+      | _ -> false
