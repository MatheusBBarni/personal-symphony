+      else if !in_section then
+        let value =
+          trimmed
+          |> Util.drop_prefix ~prefix:"-"
+          |> Option.value ~default:trimmed
+          |> Util.trim
+        in
+        let value =
+          if String.length value >= 2 && value.[0] = '`' && value.[String.length value - 1] = '`' then
