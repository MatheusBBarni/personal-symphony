  1019	let parse_int_after s idx =
  1020	  let len = String.length s in
  1021	  let rec skip i =
  1022	    if i >= len then None
  1023	    else
  1024	      match s.[i] with
  1025	      | '0' .. '9' -> digits i i
  1026	      | ':' | '=' | ' ' | '\t' | '"' | '\'' -> skip (i + 1)
  1027	      | _ -> None
  1028	  and digits start i =
  1029	    if i < len then
  1030	      match s.[i] with
  1031	      | '0' .. '9' -> digits start (i + 1)
  1032	      | _ -> Some (String.sub s start (i - start) |> int_of_string)
  1033	    else Some (String.sub s start (i - start) |> int_of_string)
  1034	  in
  1035	  skip idx
  1036	
  1037	let find_int_key key s =
  1038	  let len = String.length s and key_len = String.length key in
  1039	  let rec loop i found =
  1040	    if i + key_len > len then found
  1041	    else if String.sub s i key_len = key then
  1042	      loop (i + key_len) (parse_int_after s (i + key_len) |> Option.value ~default:found)
  1043	    else loop (i + 1) found
  1044	  in
  1045	  loop 0 0
