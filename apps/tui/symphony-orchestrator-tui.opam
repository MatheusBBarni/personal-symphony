# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Terminal UI toolkit for OCaml applications"
description:
  "An OCaml terminal UI toolkit with a buffered renderer, Toffee-backed flexbox layout, reusable widgets, key parsing, keymaps, viewport helpers, and terminal rendering helpers."
maintainer: ["MatheusBBarni <brehm.matheus@hotmail.com>"]
authors: ["Matheus Barni"]
license: "MIT"
tags: ["terminal" "tui" "ui" "widgets" "layout"]
homepage: "https://github.com/MatheusBBarni/symphony-orchestrator"
doc:
  "https://github.com/MatheusBBarni/symphony-orchestrator/tree/main/apps/tui#readme"
bug-reports: "https://github.com/MatheusBBarni/symphony-orchestrator/issues"
depends: [
  "dune" {>= "3.19"}
  "ocaml" {>= "5.1"}
  "reason"
  "uutf"
  "toffee"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/MatheusBBarni/symphony-orchestrator.git"
x-maintenance-intent: ["(latest)"]
