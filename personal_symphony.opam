opam-version: "2.0"
synopsis: "OCaml/ReScript Symphony service scaffold"
maintainer: ["MatheusBBarni <brehm.matheus@hotmail.com>"]
authors: ["MatheusBBarni <brehm.matheus@hotmail.com>"]
license: "LicenseRef-Proprietary"
homepage: "https://github.com/MatheusBBarni/symphony-orchestrator#readme"
bug-reports: "https://github.com/MatheusBBarni/symphony-orchestrator/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.19"}
  "yojson"
  "cmdliner"
  "alcotest"
  "reason"
  "tui"
  "uutf"
  "toffee"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
