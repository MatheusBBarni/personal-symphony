{
  "tracker": {
    "kind": "compozy_tasks",
    "compozy": {
      "root": ".compozy/tasks",
      "maxTaskStepRetries": 2
    }
  },
  "project": {
    "statusField": "Status",
    "activeStates": ["pending", "in_planning", "in_progress", "in_execution", "in_review"],
    "terminalStates": ["human_attention", "completed", "failed", "skipped"],
    "startStatus": "in_progress",
    "reviewStatus": "in_review",
    "retryStatus": "pending",
    "ensureStatuses": true
  },
  "polling": {
    "intervalMs": 30000
  },
  "workspace": {
    "root": ".symphony/workspaces"
  },
  "harnesses": {
    "codex": {
      "kind": "codex",
      "command": "codex exec",
      "model": "gpt-5.5",
      "reasoningEffort": "medium",
      "loop": {
        "enabled": true,
        "command": "/goal"
      }
    },
    "pi": {
      "kind": "pi",
      "command": "pi --model <model> --thinking <reasoning> --print --no-session",
      "model": "openai-codex/gpt-5.5",
      "reasoningEffort": "xhigh",
      "loop": {
        "enabled": false,
        "command": ""
      }
    }
  },
  "agents": {
    "planner": {
      "harness": "codex",
      "model": "gpt-5.4",
      "reasoningEffort": "high",
      "turnTimeoutMs": 3600000,
      "readTimeoutMs": 5000,
      "stallTimeoutMs": 300000
    },
    "engineer": {
      "harness": "codex",
      "model": "gpt-5.5",
      "reasoningEffort": "xhigh",
      "turnTimeoutMs": 3600000,
      "readTimeoutMs": 5000,
      "stallTimeoutMs": 300000
    },
    "reviewer": {
      "harness": "codex",
      "model": "gpt-5.4",
      "reasoningEffort": "xhigh",
      "turnTimeoutMs": 3600000,
      "readTimeoutMs": 5000,
      "stallTimeoutMs": 300000
    }
  },
  "git": {
    "taskBranchPrefix": "symphony/task-",
    "protectedTrunkBranches": ["main"],
    "autoMerge": false,
    "mergeAttentionStatus": "human_attention",
    "cleanup": {
      "removeWorktreeAfterMerge": true,
      "keepTaskBranch": false
    }
  },
  "pullRequest": {
    "enabled": true,
    "mode": "task",
    "openOnReview": true,
    "baseBranch": "main",
    "title": "Symphony: <issue_identifier> from <head_branch> into <base_branch>",
    "body": "Automated Task Pull Request opened by Symphony after the task reached review.\n\nIssue: <issue_identifier>\nTask Branch: <head_branch>\nPull Request Base Branch: <base_branch>\n\nReview this task before merging into the Protected Trunk Branch."
  },
  "paths": {
    "protected": {
      "patterns": [
        {
          "name": "cli-package-entrypoint",
          "pattern": "bin/symphony.js",
          "reason": "Package entrypoint changes require explicit human scope."
        },
        {
          "name": "package-binary-script",
          "pattern": "scripts/package-binary.js",
          "reason": "Packaged binary assembly affects npm distribution."
        },
        {
          "name": "package-platforms-script",
          "pattern": "scripts/package-platforms.js",
          "reason": "Platform package metadata affects npm distribution."
        },
        {
          "name": "npm-export-validation",
          "pattern": "scripts/validate-npm-export.js",
          "reason": "Package export validation protects release payload correctness."
        },
        {
          "name": "npm-export-workflow",
          "pattern": ".github/workflows/export-npm.yml",
          "reason": "Release workflow changes require explicit human scope."
        },
        {
          "name": "package-manifest",
          "pattern": "package.json",
          "reason": "Package metadata changes affect the published CLI Package."
        },
        {
          "name": "package-lockfile",
          "pattern": "pnpm-lock.yaml",
          "reason": "Dependency lockfile changes affect package build reproducibility."
        },
        {
          "name": "platform-binary-payloads",
          "pattern": "vendor/symphony-*",
          "reason": "Packaged platform binaries are release payloads."
        }
      ],
      "authorization": {
        "issueSection": "Protected Path Authorization"
      }
    }
  },
  "stageAgents": {
    "enabled": true,
    "root": ".symphony/agents",
    "defaultAgent": "engineer",
    "stages": [
      {
        "states": ["pending", "in_planning"],
        "agent": "planner",
        "skills": [],
        "startStatus": "in_planning",
        "successStatus": "in_progress",
        "retryStatus": "pending",
        "goal": {
          "enabled": true
        },
        "commit": {
          "enabled": false,
          "type": "docs",
          "message": "<type>: <generated_message_max_90char>",
          "push": false
        }
      },
      {
        "states": ["in_progress", "in_execution"],
        "agent": "engineer",
        "skills": [],
        "startStatus": "in_execution",
        "successStatus": "in_review",
        "retryStatus": "pending",
        "goal": {
          "enabled": false
        },
        "commit": {
          "enabled": true,
          "type": "feat",
          "message": "<type>: <generated_message_max_90char>",
          "push": true
        }
      },
      {
        "states": ["in_review"],
        "agent": "reviewer",
        "skills": [],
        "startStatus": "in_review",
        "successStatus": "completed",
        "retryStatus": "human_attention",
        "goal": {
          "enabled": true
        },
        "commit": {
          "enabled": true,
          "type": "refactor",
          "message": "<type>: <generated_message_max_90char>",
          "push": true
        }
      }
    ]
  },
  "agent": {
    "maxConcurrentAgents": 2,
    "maxTurns": 10,
    "maxRetryBackoffMs": 300000
  },
  "server": {
    "port": 8080
  }
}
